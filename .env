# Copy this file to .env for local development (do NOT commit .env).
# On Render / Vercel, set these as dashboard environment variables instead —
# they don't read .env files automatically.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. Set to a Postgres URL in production:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
